# OpsPilot user configuration (dotenv syntax).
# Copy to ~/.config/opspilot/config.env, or point OPSPILOT_CONFIG_FILE at it.
# Every setting can also be given as an environment variable.
# OpsPilot never reads the .env of the project you are analysing for these.
# Full reference: docs/configuration.md

# --- Provider selection -------------------------------------------------
# auto (default) = local Ollama only. Naming a cloud provider opts in to it.
# OPSPILOT_PROVIDER=auto
# In auto mode, fall back to cloud providers (that have keys) if Ollama fails.
# OPSPILOT_ALLOW_CLOUD=false

# --- Local: Ollama ------------------------------------------------------
# OPSPILOT_OLLAMA_HOST=http://localhost:11434
# OPSPILOT_OLLAMA_MODEL=llama3.2

# --- Cloud (opt in) -----------------------------------------------------
# GOOGLE_API_KEY=
# OPSPILOT_GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# OPSPILOT_ANTHROPIC_MODEL=claude-haiku-5-5
# OPENROUTER_API_KEY=
# OPSPILOT_OPENROUTER_MODEL=        # required for OpenRouter

# --- Limits -------------------------------------------------------------
# OPSPILOT_REQUEST_TIMEOUT=120
# OPSPILOT_DEADLINE=300
# OPSPILOT_MAX_RETRIES=2
# OPSPILOT_BUILD_TIMEOUT=300

# --- Privacy ------------------------------------------------------------
# OPSPILOT_REDACT=true
